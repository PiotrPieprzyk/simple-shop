# Non-secret settings, committed to git. Secrets never go here:
#   - the Cloudflare API token comes from the CLOUDFLARE_API_TOKEN environment variable,
#   - AWS credentials come from `aws login` / your AWS profile,
#   - the Sanity read token and the PayU client secret and second key are put into SSM with the
#     AWS CLI (see README.md),
#   - the origin secret is generated by Terraform (secrets.tf).
# Everything else uses the defaults in variables.tf.

domain = "shop.piotrpieprzyk.com"

# Not secret: an ID, not a credential (zone piotrpieprzyk.com).
cloudflare_zone_id = "7df0664c3f3cc04187fa1b3016f688eb"

sanity_project_id = "elq0qoon"
sanity_dataset    = "production"

# PayU's public sandbox test POS. Replace with your own sandbox POS (README.md, "Setting up PayU"),
# and put its client secret and second key into SSM.
payu_pos_id    = "521536"
payu_client_id = "521536"
